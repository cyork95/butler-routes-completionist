  goto 32.12,29.24
  turnin 571 -- Mok'thardin's Enchantment - the sinew to Mok'thardin
  accept 573 -- Mok'thardin's Enchantment - Mok'thardin; ten Naga Explorers and the Holy Spring Water, south
