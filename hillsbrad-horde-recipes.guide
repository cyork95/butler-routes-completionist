step Cooking - the Torn Fin shallows (rare drop)

  when skill Cooking 1

  loop
  goto 35.68,66.4
  goto 37.24,69.14
  goto 40.4,71.23
  goto 44.15,71.11
  goto 45.98,66.75
  goto 47.15,68.34
  collect 249881 "Recipe: Root Tea" optional
  note Dropped only by the Torn Fin Oracle (level 30), which patrols these points; the recipe drops nowhere else and has no vendor anywhere in the data.

step Blacksmithing - the Syndicate camp (rare drop)

  when skill Blacksmithing 1

  loop
  goto 65.78,48.49
  goto 67.07,47.7
  goto 74.37,40.5
  goto 76.23,40.83
  goto 77.91,41.35
  goto 79.54,45.55
  goto 81.16,41.95
  goto 67.6,47.59
  goto 76.36,46.41
  goto 79.83,40.76
