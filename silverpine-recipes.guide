step Alchemy - Raging Rot Hide (drop)

  zone map 1421

  when skill Alchemy 1

  loop
  goto 65.15,23.2
  goto 65.2,23.87
  goto 65.21,24.92
  goto 65.31,23.46
  goto 65.71,23.78
  goto 65.75,23.39
  goto 66.05,23.93
  goto 66.18,24.78
  goto 66.33,23.33
